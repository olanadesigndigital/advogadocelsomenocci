# URL pública definitiva do site — usada em canonical, Open Graph e sitemap.
# Substitua pelo domínio real do escritório em produção.
VITE_SITE_URL=https://celsomenocciadv.com.br

# Chave de API do Google Places (New) — atualiza automaticamente as avaliações
# exibidas a partir do perfil do Google Empresas (Place Details).
# Opcional: sem ela, o site exibe as avaliações reais cadastradas em src/lib/reviews.ts.
GOOGLE_PLACES_API_KEY=
